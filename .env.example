# Copy to .env.local (or .env) and fill in real values. Never commit the filled-in file.

# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/duesly"

# Random 32+ character secret used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL this app is served from. Used to build pay links, QR codes, and callback URLs.
# Must NOT be localhost in production.
APP_URL="http://localhost:3000"

# Which PaymentGateway adapter to use. Only "paystack" exists today.
PAYMENT_GATEWAY="paystack"

# Paystack API keys (test keys in every non-production environment).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Duesly's service fee on each online payment. Set exactly one of these — if both are set,
# the percentage wins. If neither is set, it defaults to 1%.
SERVICE_FEE_PERCENT="1"
# SERVICE_FEE_FLAT_KOBO="10000"

# Email (Resend). Optional — omit to skip sending receipts/alerts/reminders.
RESEND_API_KEY=""
EMAIL_FROM="Duesly <onboarding@resend.dev>"

# Optional: also BCC a copy of every payment-received/failed notification here for monitoring.
# NOTIFY_EMAIL=""
